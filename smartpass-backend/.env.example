PORT=3000
# Use your MongoDB Atlas connection string. Do not commit a real password.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smartpass?retryWrites=true&w=majority
JWT_SECRET=change-this-secret
JWT_EXPIRE=7d
QR_SIGNING_SECRET=your-32-character-or-longer-qr-signing-secret-key-here
# VNPay Sandbox Configuration (never commit real secrets)
VNPAY_TMN_CODE=your_vnpay_tmn_code_here
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/wallet/vnpay-return
VNPAY_IPN_URL=http://localhost:3000/api/wallet/vnpay/ipn
